APP_NAME=Banking Customer Intelligence (A-H)
ENVIRONMENT=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO
TENANT_ID=demo-bank
CODE_VERSION=0.1.0
SCHEMA_VERSION=1.0.0

DATA_DIR=./data
DATABASE_PATH=./data/local/bci.db
OBJECT_STORE=local
LOCAL_OBJECT_ROOT=./data/local/objects

FEEDBACK_SOURCE_PATH=./data/raw/feedback/synthetic_banking_app_feedback_15000.csv
JIRA_SOURCE_PATH=./data/raw/jira/sample_backlog_upload.csv
TAXONOMY_PATH=./taxonomy/banking_taxonomy_v1.yaml

# Provider (local-first; Gemini key provided by user)
GENERATION_PROVIDER=gemini
EMBEDDING_PROVIDER=local
EXTRACTION_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOW_CLOUD_CALLS=true
RANDOM_SEED=42
